<UserControl x:Class="Jarvis.App.Controls.MiniRobot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="200" Focusable="False"
             Background="{x:Null}" SnapsToDevicePixels="False" UseLayoutRounding="False">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="RobotShell" StartPoint="0.25,0" EndPoint="0.72,1">
      <GradientStop Color="#8A909A" Offset="0"/>
      <GradientStop Color="#606670" Offset="0.17"/>
      <GradientStop Color="#393E46" Offset="0.52"/>
      <GradientStop Color="#262B31" Offset="0.82"/>
      <GradientStop Color="#50565F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RobotBody" StartPoint="0.15,0" EndPoint="0.85,0.95">
      <GradientStop Color="#616873" Offset="0"/>
      <GradientStop Color="#454B55" Offset="0.28"/>
      <GradientStop Color="#32373E" Offset="0.67"/>
      <GradientStop Color="#20252B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RobotLimb" StartPoint="0,0.2" EndPoint="1,0.8">
      <GradientStop Color="#797F88" Offset="0"/>
      <GradientStop Color="#505761" Offset="0.23"/>
      <GradientStop Color="#333941" Offset="0.63"/>
      <GradientStop Color="#1D2228" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="RobotVisor" Center="0.46,0.24" GradientOrigin="0.38,0.08" RadiusX="0.8" RadiusY="0.9">
      <GradientStop Color="#242B31" Offset="0"/>
      <GradientStop Color="#11171B" Offset="0.36"/>
      <GradientStop Color="#060A0D" Offset="0.8"/>
      <GradientStop Color="#0D1216" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RobotRim" StartPoint="0,0" EndPoint="0.65,1">
      <GradientStop Color="#B2B8C2" Offset="0"/>
      <GradientStop Color="#6C737D" Offset="0.35"/>
      <GradientStop Color="#292E35" Offset="0.64"/>
      <GradientStop Color="#69707A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RobotShine" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#3CFFFFFF" Offset="0"/>
      <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
  </UserControl.Resources>
  <!-- Preserve vector coordinates through DPI/Viewbox scaling: independently rounding the
       chest ellipses shifts their shared center relative to the arc and fault mark.
       Null surfaces leave the space around the silhouette hit-test free. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="180" Height="200" Background="{x:Null}">
      <!-- Rounded soles sit under the body, without a rectangular ground plane. -->
      <Path Data="M 52,178 C 56,174 76,174 81,179 L 82,188 C 82,193 76,194 62,193 C 51,193 47,191 48,187 Z"
            Fill="{StaticResource RobotLimb}" Stroke="#6E747E" StrokeThickness="0.7"/>
      <Path Data="M 99,179 C 104,175 124,175 129,179 L 133,187 C 134,192 129,194 117,193 C 103,194 98,192 98,188 Z"
            Fill="{StaticResource RobotLimb}" Stroke="#646B75" StrokeThickness="0.7"/>
      <Path Data="M 52,188 Q 66,191 79,188 M 102,188 Q 116,191 130,188" Stroke="#1B2026" StrokeThickness="1.4"/>
      <!-- Small shoulder joints and soft, tapered arms. -->
      <Ellipse Canvas.Left="41" Canvas.Top="124" Width="19" Height="20" Fill="#20262C"/>
      <Ellipse Canvas.Left="120" Canvas.Top="124" Width="19" Height="20" Fill="#20262C"/>
      <Path Data="M 48,125 C 40,123 29,137 22,151 C 16,163 17,170 24,172 C 32,176 41,163 47,152 C 54,139 57,127 48,125 Z"
            Fill="{StaticResource RobotLimb}" Stroke="#747B85" StrokeThickness="0.7"/>
      <Path Data="M 132,125 C 140,123 151,137 158,151 C 164,163 163,170 156,172 C 148,176 139,163 133,152 C 126,139 123,127 132,125 Z"
            Fill="{StaticResource RobotLimb}" Stroke="#636B75" StrokeThickness="0.7"/>
      <Path Data="M 42,130 C 34,137 25,152 23,160 M 137,130 C 145,138 153,151 156,160"
            Stroke="#347F8793" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <Path Data="M 58,116 L 122,116 L 125,129 C 130,145 134,163 131,173 C 129,182 51,182 49,173 C 46,163 50,145 55,129 Z"
            Fill="{StaticResource RobotBody}" Stroke="#555D68" StrokeThickness="0.9"/>
      <Path Data="M 58,122 Q 90,129 122,122" Stroke="#181E24" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <Path Data="M 58,129 Q 90,135 122,129" Stroke="#1EABB2BF" StrokeThickness="1.1"/>
      <Path Data="M 53,171 Q 90,179 127,171" Stroke="#1D2228" StrokeThickness="1.2"/>
      <Ellipse Canvas.Left="78" Canvas.Top="141" Width="24" Height="24" Fill="#252D34" Stroke="#69727D" StrokeThickness="0.65"/>
      <Ellipse x:Name="ChestRing" Canvas.Left="81" Canvas.Top="144" Width="18" Height="18"
               Stroke="{DynamicResource ThemeCompanionAccent}" StrokeThickness="2.2"/>
      <Path x:Name="ChestArc" Data="M 90,144 A 9,9 0 1 1 81,153" Stroke="{DynamicResource ThemeCompanionAccent}"
            StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed">
        <Path.RenderTransform><RotateTransform x:Name="ChestRotation" CenterX="90" CenterY="153"/></Path.RenderTransform>
      </Path>
      <Path x:Name="ChestMark" Data="M 90,148 L 90,154 M 90,158 L 90,158.2"
            Stroke="{DynamicResource ThemeCompanionAccent}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
      <!-- Ears and main shell: the rim and inset visor provide depth without bitmap blur. -->
      <Path Data="M 24,45 C 13,46 12,53 12,66 C 12,83 15,94 24,94 L 29,83 L 29,53 Z"
            Fill="{StaticResource RobotLimb}" Stroke="#7F8690" StrokeThickness="0.7"/>
      <Path Data="M 156,45 C 167,46 168,53 168,66 C 168,83 165,94 156,94 L 151,83 L 151,53 Z"
            Fill="{StaticResource RobotLimb}" Stroke="#6B737E" StrokeThickness="0.7"/>
      <Path Data="M 18,52 C 16,63 17,81 20,87 M 162,52 C 164,63 163,81 160,87"
            Stroke="#1E242B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <Path Data="M 22,59 C 22,25 40,8 88,8 C 136,7 158,24 158,58 L 158,83 C 158,111 145,120 91,121 C 40,121 22,111 22,84 Z"
            Fill="{StaticResource RobotShell}" Stroke="{StaticResource RobotRim}" StrokeThickness="1.15"/>
      <Path Data="M 31,39 C 39,18 58,13 89,13 C 118,12 139,20 148,38 C 128,26 51,26 31,39 Z"
            Fill="{StaticResource RobotShine}" IsHitTestVisible="False"/>
      <Path Data="M 29,60 C 29,38 42,30 89,30 C 136,29 151,38 151,60 L 151,82 C 151,104 138,113 91,113 C 43,113 29,104 29,83 Z"
            Fill="#171C21" Stroke="#7A828C" StrokeThickness="0.9"/>
      <Path Data="M 32,61 C 32,40 44,33 89,33 C 133,32 148,40 148,61 L 148,81 C 148,102 135,110 91,110 C 46,110 32,102 32,82 Z"
            Fill="{StaticResource RobotVisor}" Stroke="#030609" StrokeThickness="1.4"/>
      <Path Data="M 41,46 C 49,37 70,36 88,36 C 108,35 128,38 139,45"
            Stroke="#28BCC4D0" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
      <Canvas x:Name="Eyes" Width="180" Height="120" IsHitTestVisible="False">
        <Canvas.RenderTransform><ScaleTransform x:Name="EyeScale" CenterX="90" CenterY="69"/></Canvas.RenderTransform>
        <Path x:Name="LeftEye" Data="M 51,69 L 70,69" Stroke="{DynamicResource ThemeCompanionAccent}" StrokeThickness="6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        <Path x:Name="RightEye" Data="M 110,69 L 129,69" Stroke="{DynamicResource ThemeCompanionAccent}" StrokeThickness="6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Canvas>
      <Path x:Name="Mouth" Stroke="{DynamicResource ThemeCompanionAccent}" StrokeThickness="2.6" StrokeStartLineCap="Round"
            StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Canvas>
  </Viewbox>
</UserControl>
