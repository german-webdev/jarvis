<Window x:Class="Jarvis.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Jarvis.App.Controls" Title="JARVIS" Width="1280" Height="850" MinWidth="1120" MinHeight="720"
        Background="{DynamicResource ThemeWindow}" Foreground="{DynamicResource ThemeText}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Icon="/Jarvis;component/Assets/jarvis.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style x:Key="HeaderKeyboardFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <Rectangle Margin="-3" Stroke="{DynamicResource ThemeAccentInk}" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="10" RadiusY="10"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource HeaderKeyboardFocus}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeHover}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeSelection}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="VoiceControlStyle" TargetType="Button">
      <Setter Property="Width" Value="72"/><Setter Property="Height" Value="72"/>
      <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid UseLayoutRounding="True">
            <Ellipse x:Name="FocusRing" Stroke="{DynamicResource ThemeAccentInk}" StrokeThickness="1" StrokeDashArray="2,2" Margin="1" Visibility="Collapsed"/>
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="32" Margin="4">
              <Grid>
                <Grid x:Name="MicrophoneIcon" Width="32" Height="32">
                  <Rectangle Width="10" Height="18" RadiusX="5" RadiusY="5" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" VerticalAlignment="Top" Margin="0,2,0,0"/>
                  <Path Data="M 7,14 L 7,17 C 7,29 25,29 25,17 L 25,14 M 16,26 L 16,30 M 11,30 L 21,30" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <Rectangle x:Name="StopIcon" Width="20" Height="20" RadiusX="2" RadiusY="2" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding CanStop}" Value="True">
              <Setter TargetName="MicrophoneIcon" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="StopIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.75"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding CanRestart}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
        <DataTrigger Binding="{Binding CanStop}" Value="True">
          <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
          <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid x:Name="LayoutRoot">
    <controls:WorkspaceShell x:Name="Shell"/>
    <Grid x:Name="HomePage" Margin="28,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="240"/><RowDefinition Height="2*" MinHeight="132" MaxHeight="256"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="TextCommandButton" Style="{StaticResource HeaderIconButtonStyle}" Click="TextCommandClick" IsEnabled="{Binding CanEnterText}"
                  ToolTip="{DynamicResource UiD4A81996CFF9}" AutomationProperties.Name="{DynamicResource UiD4A81996CFF9}">
            <controls:ComposeIcon Width="22" Height="22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="MiniJarvisButton" Style="{StaticResource HeaderIconButtonStyle}" Click="MiniClick" Margin="8,0,0,0"
                  ToolTip="{DynamicResource Ui57600DBE9D73}" AutomationProperties.Name="{DynamicResource Ui57600DBE9D73}">
            <Path Width="22" Height="22" Stretch="Uniform" Data="M 10,5 L 10,13 L 18,13 M 20,3 L 10,13 M 8,5 L 4,5 Q 2,5 2,7 L 2,19 Q 2,21 4,21 L 16,21 Q 18,21 18,19 L 18,15"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
        <StackPanel><TextBlock Text="{DynamicResource UiD328E53DC456}" FontSize="26" FontWeight="SemiBold"/></StackPanel>
      </DockPanel>
      <Border x:Name="VoicePanel" Grid.Row="1" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Background="{DynamicResource ThemeSurface}" Padding="22,20">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding PhaseTitle}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource ThemeMuted}" Margin="0,8,0,0" TextAlignment="Center" MaxWidth="690" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></StackPanel>
          <controls:VoiceVisualizer Grid.Row="1" Margin="14,5" MinHeight="65" Level="{Binding Level}" Phase="{Binding Phase}" ReduceMotion="{Binding ReduceMotion}" AutomationProperties.Name="{DynamicResource Ui0497046A1EB5}"/>
          <Button x:Name="VoiceControlButton" Grid.Row="2" Style="{StaticResource VoiceControlStyle}" HorizontalAlignment="Center"
                  IsEnabled="{Binding CanToggleListening}" ToolTip="{Binding ListeningActionLabel}" AutomationProperties.Name="{Binding ListeningActionLabel}"
                  Click="VoiceControlClick"/>
          <Button x:Name="RestartWorkerButton" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Content="{DynamicResource Ui8F41B51937FB}"
                  Click="RestartWorkerClick" IsEnabled="{Binding CanRestart}" Visibility="{Binding CanRestart, Converter={StaticResource BoolVisibility}}"/>
        </Grid>
      </Border>
      <Grid x:Name="ConversationCards" Grid.Row="2" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ThemeSurface}" CornerRadius="12" Padding="18" MinHeight="116">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Ui2345FEECF4B6}" Foreground="{DynamicResource ThemeMuted}" FontSize="10"/>
            <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1" Margin="0,9,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <TextBlock x:Name="TranscriptText" Text="{Binding Transcript, NotifyOnTargetUpdated=True}" TargetUpdated="MessageTextUpdated" TextWrapping="Wrap" FontSize="14"/>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" CornerRadius="12" Padding="18" MinHeight="116">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Ui301C2D870EEA}" Foreground="{DynamicResource ThemeAccentInk}" FontSize="10"/>
            <ScrollViewer x:Name="ReplyScroll" Grid.Row="1" Margin="0,9,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <TextBlock x:Name="ReplyText" Text="{Binding Reply, NotifyOnTargetUpdated=True}" TargetUpdated="MessageTextUpdated" TextWrapping="Wrap" FontSize="14"/>
            </ScrollViewer>
            <Button Grid.Row="2" Content="{DynamicResource Ui406FB42FCBCB}" Click="ArtifactClick" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,5" Visibility="{Binding HasArtifact, Converter={StaticResource BoolVisibility}}"/>
            <Button Grid.Row="2" Content="{DynamicResource Ui6EE247BF8669}" Click="SourceClick" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,5" Visibility="{Binding HasSourceUrl, Converter={StaticResource BoolVisibility}}"/>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" Height="110" Margin="0,18,0,0" Visibility="{Binding ShowLog, Converter={StaticResource BoolVisibility}}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource UiF5B284F9340F}" FontWeight="SemiBold"/><Button Content="{DynamicResource UiFAFD0C22168C}" Click="ClearHistoryClick" Padding="8,4" Margin="0" HorizontalAlignment="Right"/></DockPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding History}" Background="Transparent" Foreground="{DynamicResource ThemeMuted}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,3"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource ThemeMuted}"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
