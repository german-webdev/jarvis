<Window x:Class="Jarvis.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Jarvis.App.Controls" Title="JARVIS · Помощник" Width="980" Height="850" MinWidth="780" MinHeight="690"
        Background="#0A1320" Foreground="#E9F2F7" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Menu Background="#E8EDF3" Foreground="#17283A" Padding="12,2">
      <MenuItem Header="_Джарвис"><MenuItem Header="Приложения и игры…" Click="CatalogClick"/><MenuItem Header="Команда текстом…" Click="TextCommandClick"/><Separator/><MenuItem Header="Настройки…" InputGestureText="Ctrl+," Click="SettingsClick"/><Separator/><MenuItem Header="Выход" Click="ExitClick"/></MenuItem>
      <MenuItem Header="_Вид"><MenuItem Header="Журнал событий" IsCheckable="True" IsChecked="{Binding ShowLog}"/><MenuItem Header="Очистить журнал" Click="ClearHistoryClick"/></MenuItem>
      <MenuItem Header="_Справка"><MenuItem Header="Что я умею" Click="HelpClick"/></MenuItem>
    </Menu>
    <Grid Grid.Row="1" Margin="28,20,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="240"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right" Content="⚙  Настройки" Click="SettingsClick" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Padding="15,10"/>
        <StackPanel><TextBlock Text="J A R V I S" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="ПЕРСОНАЛЬНЫЙ ПОМОЩНИК" FontSize="10" Foreground="#7E99B0" Margin="1,5,0,0"/></StackPanel>
      </DockPanel>
      <Border Grid.Row="1" CornerRadius="18" BorderBrush="#213347" BorderThickness="1" Background="#0E1B2B" Padding="22,20">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding PhaseTitle}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/><TextBlock Text="{Binding Status}" Foreground="#A1B5C8" Margin="0,8,0,0" TextAlignment="Center" MaxWidth="690"/></StackPanel>
          <controls:VoiceVisualizer Grid.Row="1" Margin="14,5" MinHeight="65" Level="{Binding Level}" Phase="{Binding Phase}" ReduceMotion="{Binding ReduceMotion}" AutomationProperties.Name="Звуковая волна помощника"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Начать" Background="#64DCC6" Foreground="#092820" MinWidth="136" FontWeight="SemiBold" IsEnabled="{Binding CanListen}" Click="ListenClick"/><Button Content="Стоп" MinWidth="100" Click="StopClick" IsEnabled="{Binding Busy}" Margin="0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="#111F30" CornerRadius="12" Padding="18" MinHeight="116"><StackPanel><TextBlock Text="ТВОЯ КОМАНДА" Foreground="#7E99B0" FontSize="10"/><TextBlock Text="{Binding Transcript}" FontSize="17" Margin="0,9,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Background="#142333" CornerRadius="12" Padding="18" MinHeight="116"><StackPanel><TextBlock Text="ОТВЕТ ДЖАРВИСА" Foreground="#73CDBD" FontSize="10"/><TextBlock Text="{Binding Reply}" FontSize="17" Margin="0,9,0,0"/><Button Content="Открыть скриншот" Click="ArtifactClick" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,5" Visibility="{Binding HasArtifact, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
      </Grid>
      <Border Grid.Row="3" Margin="0,18,0,0" Visibility="{Binding ShowLog, Converter={StaticResource BoolVisibility}}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="110"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8"><TextBlock Text="Журнал событий" FontWeight="SemiBold"/><TextBlock Text="Только в текущем сеансе" FontSize="11" Foreground="#6D879E" HorizontalAlignment="Right"/></DockPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding History}" Background="Transparent" Foreground="#9DB2C5" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,3"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="#9DB2C5"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#101D2C" Padding="22,10"><DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="Esc — остановить" Foreground="#69859E" FontSize="11"/>
      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding MicrophoneLabel}" FontSize="11" Foreground="#A2B9CB"/><TextBlock Text="  ·  " Foreground="#4C687F"/><TextBlock Text="{Binding ModeLabel}" Foreground="#7F9DB4" FontSize="11"/><TextBlock Text="  ·  " Foreground="#4C687F"/><TextBlock Text="{Binding VoiceLabel}" Foreground="#7F9DB4" FontSize="11"/></StackPanel>
    </DockPanel></Border>
  </Grid>
</Window>
