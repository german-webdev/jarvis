<Window x:Class="Jarvis.App.MiniSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="{DynamicResource ThemeWindow}" Foreground="{DynamicResource ThemeText}" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <DataTemplate x:Key="ChoiceTemplate"><TextBlock Text="{Binding Label}"/></DataTemplate>
  </Window.Resources>
  <StackPanel Margin="24">
    <Label x:Name="ViewLabel" Target="{Binding ElementName=MiniViewBox}" Padding="0,0,0,8" Foreground="{DynamicResource ThemeText}"/>
    <ComboBox x:Name="MiniViewBox" SelectedValuePath="Id" ItemTemplate="{StaticResource ChoiceTemplate}" MinHeight="36" SelectionChanged="SelectionChanged"/>
    <DockPanel Margin="0,18,0,8">
      <TextBlock x:Name="RobotScaleLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Text="100%"/>
      <Label x:Name="SizeLabel" Target="{Binding ElementName=RobotScaleSlider}" Padding="0" Foreground="{DynamicResource ThemeText}"/>
    </DockPanel>
    <Slider x:Name="RobotScaleSlider" Minimum="60" Maximum="160" Value="100" SmallChange="1" LargeChange="10"
            IsSnapToTickEnabled="False" MinHeight="28" ValueChanged="RobotScaleChanged"/>
    <TextBlock x:Name="ErrorFeedback" Foreground="{DynamicResource ThemeError}" FontSize="12" TextWrapping="Wrap"
               Visibility="Collapsed" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
  </StackPanel>
</Window>
