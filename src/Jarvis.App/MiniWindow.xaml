<Window x:Class="Jarvis.App.MiniWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Jarvis.App.Controls" Title="Mini JARVIS" Width="228" Height="272"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual"
        Foreground="{DynamicResource ThemeText}" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="MiniAction" TargetType="Button">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="3,0"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeHover}"/><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ThemeAccentInk}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="MiniSurface" MouseEnter="SurfaceEnter" MouseLeave="SurfaceLeave" PreviewMouseLeftButtonDown="DragSurface" PreviewMouseRightButtonUp="ShowContextMenu">
    <!-- Keep the path from robot to buttons interactive while expanded, including gaps
         in the silhouette. The rest of the transparent window remains click-through. -->
    <Border x:Name="HoverSurface" Width="180" Height="256" VerticalAlignment="Bottom" Margin="0,0,0,14"
            Background="Transparent" Visibility="Collapsed"/>
    <Border x:Name="RobotSurface" Width="180" Height="200" VerticalAlignment="Bottom" Margin="0,0,0,64" Focusable="True"
            RenderTransformOrigin="0.5,0.97" UseLayoutRounding="False"
            AutomationProperties.Name="{Binding PhaseTitle}" AutomationProperties.HelpText="{Binding MicrophoneLabel}">
      <Border.RenderTransform><ScaleTransform x:Name="RobotScale"/></Border.RenderTransform>
      <Viewbox Stretch="Uniform">
        <controls:MiniRobot x:Name="Robot" Phase="{Binding Phase}" MicrophoneActive="{Binding MicrophoneActive}" CanStop="{Binding CanStop}" ReduceMotion="{Binding ReduceMotion}"/>
      </Viewbox>
    </Border>
    <Border x:Name="Platform" Width="104" Height="18" VerticalAlignment="Top" Margin="0,202,0,0" CornerRadius="5" UseLayoutRounding="False"
            Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" ClipToBounds="True"
            AutomationProperties.Name="{Binding PhaseTitle}" AutomationProperties.HelpText="{Binding MicrophoneLabel}">
      <Grid>
        <Border x:Name="PlatformMark" Width="32" Height="2" CornerRadius="1" Background="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
        <StackPanel x:Name="ActionStrip" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
          <Button x:Name="MiniTextButton" Style="{StaticResource MiniAction}" IsEnabled="{Binding CanEnterText}" Click="TextClick">
            <controls:ComposeIcon Width="22" Height="22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="MiniVoiceButton" Style="{StaticResource MiniAction}" IsEnabled="{Binding CanToggleListening}" Click="VoiceClick"
                  Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentText}"
                  ToolTip="{Binding ListeningActionLabel}" AutomationProperties.Name="{Binding ListeningActionLabel}">
            <Grid Width="24" Height="26">
              <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding CanStop}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Rectangle Width="8" Height="14" RadiusX="4" RadiusY="4" Stroke="{DynamicResource ThemeAccentText}" StrokeThickness="1.6" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <Path Data="M 5,12 L 5,14 C 5,24 19,24 19,14 L 19,12 M 12,22 L 12,25 M 8,25 L 16,25" Stroke="{DynamicResource ThemeAccentText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
              <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2" Fill="{DynamicResource ThemeAccentText}"><Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanStop}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
            </Grid>
          </Button>
          <Button x:Name="MiniOpenButton" Style="{StaticResource MiniAction}" Click="OpenClick">
            <Path Width="22" Height="22" Stretch="Uniform" Data="M 12,3 L 20,3 L 20,11 M 20,3 L 10,13 M 8,5 L 4,5 Q 2,5 2,7 L 2,19 Q 2,21 4,21 L 16,21 Q 18,21 18,19 L 18,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
