<Window x:Class="Jarvis.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки · JARVIS" Width="730" Height="780" MinWidth="620" MinHeight="660" Background="#0D1928" Foreground="#E9F2F7" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE8F1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,18,0,8"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#8FA7BC"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
    <DataTemplate x:Key="ChoiceTemplate"><TextBlock Text="{Binding Label}" Foreground="#17283A"/></DataTemplate>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="Настройки" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Прослушивание приостановлено. Изменения применяются после сохранения." Style="{StaticResource Hint}"/></StackPanel>
    <TabControl Grid.Row="1" Background="#122236" Foreground="#E9F2F7" BorderBrush="#2A4055" Padding="18">
      <TabItem><TabItem.Header><TextBlock Text="Микрофон" Foreground="#15283A" Margin="8,5"/></TabItem.Header><StackPanel>
        <TextBlock Text="Устройство ввода" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Microphones}" SelectedValuePath="Id" SelectedValue="{Binding MicrophoneId}" Padding="10" IsEnabled="{Binding Runtime.CanSpeak}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#17283A"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <TextBlock Text="Выбери вход, к которому подключён микрофон. Для первой проверки удобнее использовать гарнитуру." Style="{StaticResource Hint}"/>
        <Button Content="Обновить устройства" HorizontalAlignment="Left" Margin="0,16,0,0" Click="RefreshClick" IsEnabled="{Binding Runtime.CanConfigure}"/>
        <TextBlock Text="Запись и приватность" Style="{StaticResource Label}"/><TextBlock Text="Речь обрабатывается локально. Аудио микрофона не сохраняется. Во время голосового ответа микрофон выключен." Style="{StaticResource Hint}"/>
      </StackPanel></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="Голос" Foreground="#15283A" Margin="8,5"/></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Тембр" Style="{StaticResource Label}" Margin="0,2,0,8"/>
        <ComboBox ItemsSource="{Binding Voices}" SelectedValuePath="Id" SelectedValue="{Binding Voice}" ItemTemplate="{StaticResource ChoiceTemplate}" Padding="9"/>
        <TextBlock Text="Характер звучания" Style="{StaticResource Label}"/>
        <ComboBox ItemsSource="{Binding Styles}" SelectedValuePath="Id" SelectedValue="{Binding VoiceStyle}" ItemTemplate="{StaticResource ChoiceTemplate}" Padding="9"/>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Роботизация" Foreground="#DCE8F1"/><TextBlock Grid.Column="1" Text="{Binding ElementName=EffectSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="#79DCC8"/></Grid>
        <Slider x:Name="EffectSlider" Value="{Binding RobotAmount}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" IsEnabled="{Binding EffectEnabled}" Margin="0,7,0,0"/>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Темп речи" Foreground="#DCE8F1"/><TextBlock Grid.Column="1" Text="{Binding ElementName=RateSlider, Path=Value, StringFormat={}{0:F2}×}" Foreground="#79DCC8"/></Grid>
        <Slider x:Name="RateSlider" Value="{Binding SpeechRate}" Minimum="0.85" Maximum="1.2" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,7,0,0"/>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Громкость ответа" Foreground="#DCE8F1"/><TextBlock Grid.Column="1" Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="#79DCC8"/></Grid>
        <Slider x:Name="VolumeSlider" Value="{Binding Volume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,7,0,0"/>
        <WrapPanel Margin="0,18,0,0"><Button Content="Прослушать" Click="PreviewClick" IsEnabled="{Binding Runtime.CanSpeak}"/><Button Content="Остановить" Click="StopClick" IsEnabled="{Binding Runtime.Busy}"/></WrapPanel>
        <TextBlock Text="Прослушивание использует выбранные здесь значения даже до сохранения. «Синтез» добавляет низкий металлический оттенок; это собственный эффект." Style="{StaticResource Hint}"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="Поведение" Foreground="#15283A" Margin="8,5"/></TabItem.Header><StackPanel>
        <TextBlock Text="Способ обращения" Style="{StaticResource Label}"/><CheckBox Content="Ожидать имя «Джарвис»" IsChecked="{Binding WakeMode}" Foreground="#E5EEF6" Margin="0,8"/>
        <TextBlock Text="После нажатия «Начать» помощник ждёт имя, затем команду. Если флажок выключен, сразу слушает команду. При запуске приложения микрофон всегда выключен." Style="{StaticResource Hint}"/>
        <TextBlock Text="Пауза после имени" Style="{StaticResource Label}"/>
        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=WaitSlider, Path=Value, StringFormat={}{0:F0} сек.}" Foreground="#79DCC8" Width="65" TextAlignment="Right"/><Slider x:Name="WaitSlider" Value="{Binding CommandWaitSeconds}" Minimum="4" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"/></DockPanel>
        <TextBlock Text="Столько времени можно подождать перед командой. Если ты ничего не сказал, Джарвис молча возвращается к ожиданию имени." Style="{StaticResource Hint}"/>
        <TextBlock Text="Остановка" Style="{StaticResource Label}"/><TextBlock Text="Кнопка «Стоп» и Esc выключают микрофон и прерывают озвучку. Уже открытый браузер остаётся открытым." Style="{StaticResource Hint}"/>
      </StackPanel></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="Приложение" Foreground="#15283A" Margin="8,5"/></TabItem.Header><StackPanel>
        <TextBlock Text="Главный экран" Style="{StaticResource Label}"/><CheckBox Content="Показывать журнал событий" IsChecked="{Binding ShowLog}" Foreground="#E5EEF6" Margin="0,8"/><CheckBox Content="Уменьшить анимацию волны" IsChecked="{Binding ReduceMotion}" Foreground="#E5EEF6" Margin="0,8"/>
        <TextBlock Text="Волна реагирует на уровень микрофона и голосового ответа. Журнал хранится только до закрытия приложения." Style="{StaticResource Hint}"/>
        <TextBlock Text="Диагностика" Style="{StaticResource Label}"/><Button Content="Перезапустить голосовой модуль" Click="RestartClick" HorizontalAlignment="Left" Margin="0,4,0,0"/>
        <TextBlock Text="Используй, если распознавание или голос перестали отвечать. Настройки сохраняются." Style="{StaticResource Hint}"/>
        <TextBlock Text="JARVIS 0.4 · локальный голосовой помощник" Foreground="#69859E" FontSize="12" Margin="0,28,0,0"/>
      </StackPanel></TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding Runtime.Status}" Foreground="#91ACBF" FontSize="12" Margin="0,14,0,14" MinHeight="32"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Click="CancelClick"/><Button Content="Сохранить" Click="SaveClick" Background="#64DCC6" Foreground="#0A2922" FontWeight="SemiBold" IsEnabled="{Binding Runtime.CanSpeak}" Margin="0"/></StackPanel>
  </Grid>
</Window>
