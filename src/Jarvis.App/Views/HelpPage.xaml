<local:WorkspacePage xmlns:local="clr-namespace:Jarvis.App" x:Class="Jarvis.App.HelpPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource ThemeWindow}" Foreground="{DynamicResource ThemeText}" FontFamily="Segoe UI" FontSize="14">
  <local:WorkspacePage.Resources>
    <Style x:Key="HelpScrollViewer" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid ClipToBounds="True" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"
                                      ClipToBounds="True"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                         Width="12" Margin="4,0,0,0" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeSelection}"/><Setter Property="Foreground" Value="{DynamicResource ThemeAccentInk}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeRaised}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </local:WorkspacePage.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,22"/>
    <Border Grid.Row="1" Background="{DynamicResource ThemeRaised}" CornerRadius="9" Padding="14,10" Margin="0,0,0,20"><DockPanel><TextBlock x:Name="SearchLabel" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource ThemeText}" BorderThickness="0" CaretBrush="{DynamicResource ThemeAccentInk}" FontSize="15" TextChanged="SearchChanged" Padding="3"/></DockPanel></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="Categories" Background="Transparent" Foreground="{DynamicResource ThemeMuted}" BorderThickness="0"
               ClipToBounds="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" SelectionChanged="CategoryChanged">
        <ListBox.Template>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" ClipToBounds="True">
              <ScrollViewer x:Name="PART_ScrollViewer" Style="{StaticResource HelpScrollViewer}" Focusable="False"
                            CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </ListBox.Template>
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="13"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Column="2">
        <ScrollViewer x:Name="ResultsScroll" Style="{StaticResource HelpScrollViewer}" Padding="0,0,8,0">
          <ItemsControl x:Name="Cards"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="{DynamicResource ThemeSurface}" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
              <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeMuted}" Margin="0,7,0,15" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding Commands}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource ThemeRaised}" CornerRadius="7" Padding="12,10" Margin="0,0,0,7"><TextBlock Text="{Binding}" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" FontSize="15"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="{Binding Note}" Foreground="{DynamicResource ThemeAccentInk}" Margin="0,9,0,0" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="EmptyState" Visibility="Collapsed" Foreground="{DynamicResource ThemeMuted}" FontSize="17" TextWrapping="Wrap" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Grid>
    </Grid>
    <Button x:Name="CloseButton" Grid.Row="3" HorizontalAlignment="Right" Click="CloseClick" IsCancel="True" Margin="0,18,0,0"/>
  </Grid>
</local:WorkspacePage>
