<local:WorkspacePage xmlns:local="clr-namespace:Jarvis.App" x:Class="Jarvis.App.MediaPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource ThemeWindow}" Foreground="{DynamicResource ThemeText}" FontFamily="Segoe UI" FontSize="14">
  <local:WorkspacePage.Resources>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/><Setter Property="Padding" Value="18,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{DynamicResource ThemeSurface}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeRaised}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ThemeRaised}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Padding" Value="12,12"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSelection}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="{DynamicResource ThemeRaised}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="RowBackground" Value="{DynamicResource ThemeSurface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeRaised}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="44"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="SelectionMode" Value="Single"/></Style>
  </local:WorkspacePage.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold"/></StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource ThemeAccentInk}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock x:Name="PlaybackState" Foreground="{DynamicResource ThemeMuted}" FontSize="12"/><TextBlock x:Name="PlaybackTitle" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlaybackSource" Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0"/></StackPanel>
        <Button x:Name="PlaybackButton" Grid.Column="2" Click="PlaybackClick" IsEnabled="False" Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentText}" VerticalAlignment="Center" Margin="0" MinWidth="110"/>
      </Grid>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" Padding="16" Foreground="{DynamicResource ThemeText}">
      <TabItem x:Name="PlayersTab"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="PreferredLabel" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
          <ComboBox x:Name="PreferredBox" ToolTip="{DynamicResource Ui26E9A66D820B}" DisplayMemberPath="Label" SelectedValuePath="Id" Padding="8" MaxWidth="520" HorizontalAlignment="Left" MinWidth="300"/>
          </StackPanel>
        <WrapPanel x:Name="PlayerActions" Grid.Row="1" Margin="0,0,0,12"><Button x:Name="FindPlayers" Click="FindPlayersClick"/><Button x:Name="AddPlayer" Click="AddPlayerClick"/><Button x:Name="RemovePlayer" Click="RemovePlayerClick"/></WrapPanel>
        <DataGrid x:Name="PlayersGrid" Grid.Row="2" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn x:Name="PlayerNameColumn" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn x:Name="PlayerPathColumn" Binding="{Binding Target}" Width="2*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
      <TabItem x:Name="FoldersTab"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="FoldersHint" Foreground="{DynamicResource ThemeMuted}" Margin="0,0,0,12"/>
        <WrapPanel x:Name="FolderActions" Grid.Row="1" Margin="0,0,0,12"><Button x:Name="AddFolder" Click="AddFolderClick"/><Button x:Name="StandardFolders" Click="StandardFoldersClick"/><Button x:Name="ScanFolders" Click="ScanFoldersClick"/><Button x:Name="RemoveFolder" Click="RemoveFolderClick"/></WrapPanel>
        <DataGrid x:Name="FoldersGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn x:Name="FolderNameColumn" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn x:Name="FolderPathColumn" Binding="{Binding Target}" IsReadOnly="True" Width="2*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
      <TabItem x:Name="FilesTab"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <DockPanel Grid.Row="1" Margin="0,0,0,12"><WrapPanel x:Name="FileActions" DockPanel.Dock="Right"><Button x:Name="AddFile" Click="AddFileClick"/><Button x:Name="RemoveFile" Click="RemoveFileClick"/></WrapPanel><TextBlock x:Name="SearchLabel" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="Search" TextChanged="SearchChanged" Margin="0,0,12,0"/></DockPanel>
        <DataGrid x:Name="FilesGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn x:Name="FileNameColumn" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn x:Name="FileKindColumn" Binding="{Binding KindLabel}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn x:Name="FileAliasesColumn" Binding="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn x:Name="FilePathColumn" Binding="{Binding Target}" Width="1.5*" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
    </TabControl>
    <TextBlock x:Name="Status" Grid.Row="3" Foreground="{DynamicResource ThemeMuted}" Margin="0,14,0,14" MaxHeight="76" TextTrimming="CharacterEllipsis"/>
    <DockPanel Grid.Row="4"><Button x:Name="StopScan" Click="StopScanClick" HorizontalAlignment="Left" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Click="CancelClick"/><Button x:Name="SaveButton" Click="SaveClick" Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentText}" Margin="0"/></StackPanel></DockPanel>
  </Grid>
</local:WorkspacePage>
