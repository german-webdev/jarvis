<UserControl x:Class="Jarvis.App.VideoPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource ThemeWindow}" Foreground="{DynamicResource ThemeText}">
<Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{DynamicResource Ui014F035E7A17}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" Margin="0,0,0,12"/>
  <WrapPanel><Button x:Name="ConnectButton" Content="{DynamicResource Ui329C67777ABA}" Click="ConnectClick" IsEnabled="{Binding CanUseVideo}"/><Button Content="{DynamicResource Ui3396400DA0C4}" Click="StopClick" IsEnabled="{Binding CanStopVideo}"/></WrapPanel></StackPanel>
  <Grid Grid.Row="1" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="QueryBox" MaxLength="300" MinHeight="36" VerticalContentAlignment="Center" Padding="10,4" KeyDown="QueryKeyDown" AutomationProperties.Name="{DynamicResource Ui69A9C9FEFF71}"/><Button Grid.Column="1" Content="{DynamicResource Ui61E11EDE694E}" Margin="8,0,0,0" Click="SearchClick" IsEnabled="{Binding CanUseVideo}"/></Grid>
  <TextBlock Grid.Row="2" Text="{Binding BrowserStatus}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" Margin="0,0,0,12"/>
  <ListBox Grid.Row="3" x:Name="ResultsList" ItemsSource="{Binding VideoResults}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}" KeyDown="ResultsKeyDown">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSelection}"/><Setter Property="Foreground" Value="{DynamicResource ThemeSelectionText}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ThemeAccentInk}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Channel}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Button Grid.Row="4" Content="{DynamicResource UiA10926EC9452}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OpenClick" IsEnabled="{Binding CanUseVideo}"/>
</Grid></UserControl>